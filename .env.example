# ==============================================================================
# SilverShield Guardian Configuration (.env.example)
# Copy to .env for local development. NEVER commit real secrets to Git.
# In production (Cloud Run / Vertex AI), secrets are mounted from GCP Secret
# Manager via Terraform (deployment/terraform/secrets.tf).
# ==============================================================================

# --- Runtime Environment ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Google Cloud / Gemini Configuration ---
# For Vertex AI (Production): set GOOGLE_GENAI_USE_VERTEXAI=TRUE and project/location.
# For Gemini Developer API (Local Dev): set GOOGLE_GENAI_USE_VERTEXAI=FALSE and
# provide GEMINI_API_KEY via Secret Manager or local environment.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Secret Manager toggle (set true in GCP Cloud Run / Agent Runtime)
USE_SECRET_MANAGER=false
GEMINI_API_KEY_SECRET_NAME=silvershield-gemini-api-key
# Local development only (never hardcode in source or commit .env):
# GOOGLE_API_KEY=replace-in-local-env-only

# --- Strategic Model Routing ---
SILVERSHIELD_FAST_MODEL=gemini-2.5-flash
SILVERSHIELD_REASONING_MODEL=gemini-2.5-pro

# --- Persistent Session, Knowledge Store & Memory ---
# Options: sqlite (local persistent DB), postgres (Cloud SQL), vertex_ai, memory
SESSION_BACKEND=sqlite
SESSION_DB_URL=sqlite+aiosqlite:///./data/silvershield_sessions.db
SESSION_DB_SECRET_NAME=silvershield-session-db-url

# Knowledge base persistence (SQLite vector store locally + optional Vertex AI Search)
KNOWLEDGE_DB_PATH=./data/silvershield_knowledge.db
VERTEX_AI_SEARCH_DATASTORE_ID=

# Long-term Memory Bank (Vertex AI Agent Engine ID for managed Memory Bank in prod)
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=./data/silvershield_memory.db
VERTEX_AGENT_ENGINE_ID=

# --- Context Compaction & Caching ---
COMPACTION_INTERVAL=8
COMPACTION_OVERLAP_SIZE=2
COMPACTION_TOKEN_THRESHOLD=12000
COMPACTION_EVENT_RETENTION_SIZE=6
ENABLE_CONTEXT_CACHING=true

# --- Security, Guardrails & PII Redaction ---
ENABLE_CLOUD_DLP=false
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=

# --- Observability & OpenTelemetry Tracing ---
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=silvershield-guardian
# Options: none, console, otlp, google_cloud_trace
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
LOGS_BUCKET_NAME=
BQ_ANALYTICS_DATASET_ID=
