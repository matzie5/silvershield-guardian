# Environment & secrets (NEVER commit real secrets)
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
uv.lock
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local SQLite databases & runtime data
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
artifacts/

# Terraform state & overrides
deployment/terraform/**/.terraform/
deployment/terraform/**/*.tfstate
deployment/terraform/**/*.tfstate.*
deployment/terraform/**/*.tfvars
!deployment/terraform/**/*.tfvars.example
deployment/terraform/**/.terraform.lock.hcl

# OS & Editors
.DS_Store
.vscode/
.idea/
